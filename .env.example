# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where NIO is hosted.
APP_URL="https://nio-wmgr.vercel.app"
VITE_PUBLIC_SITE_URL="https://nio-wmgr.vercel.app"

# ------------------------------------------------------------------
# Official Digital Wallet Integrations (Optional)
# Wallet buttons are hidden on guest tickets unless configured below.
# ------------------------------------------------------------------

# Apple Wallet (.pkpass PKCS#7 Signing)
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_ORGANIZATION_NAME="NIO | نيو"
# Provide PEM contents (with \n escaped) for certificate, private key, and Apple WWDR G4 cert
APPLE_WALLET_CERT_PEM=""
APPLE_WALLET_KEY_PEM=""
APPLE_WALLET_WWDR_PEM=""

# Google Wallet Event Ticket API
GOOGLE_WALLET_ISSUER_ID=""
# Service Account JSON string (or path) authorized in Google Pay & Wallet Console
GOOGLE_WALLET_SA_JSON=""

# Samsung Wallet Partner Portal Integration
SAMSUNG_WALLET_PARTNER_ID=""
SAMSUNG_WALLET_CARD_ID=""
SAMSUNG_WALLET_PRIVATE_KEY=""
